{
  "schema": 1,
  "about": [
    "Shared fixture for policy/ntfy-policy.json, run by EVERY library that reads the policy, in its",
    "own language and its own CI: edge-host tests/ntfy-policy.test.sh (bash), trade-data",
    "tests/test_ntfy_policy.py (python), mattpc-llm-stack monitoring/lib-notify.ps1 -SelfTest",
    "(PowerShell). Inputs and answers are LITERALS on purpose: a runner that derived the boundary",
    "from the policy would agree with any number. policy_sha256 pins the policy bytes (CRLF folded",
    "to LF before hashing, so a Windows checkout hashes the same).",
    "decide: in = tier, publisher, sent_today (ledger lines today), remaining (ntfy messages left;",
    "null = the probe was BLIND), et_hour (0-23 America/New_York), can_defer (a night flush exists),",
    "has_sink (a digest / held log to land a hold in). out = push | hold_cap | defer_night |",
    "hold_reserve | digest.",
    "ledger_path: the path under the state dir for one ledger line written at `utc`.",
    "replay_budget: what a spool replay may spend (edge-host flush/drain only; optional elsewhere)."
  ],
  "policy_sha256": "186af62618e5511d52f12c8402da1e28f954eb18843a3b938bdbe142876254f9",
  "required": ["decide", "ledger_path"],
  "decide": [
    {"why": "an ordinary p2 by day with plenty left pushes",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 200, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "push"},
    {"why": "the 40th push of the day is still allowed",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 39, "remaining": 200, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "push"},
    {"why": "the 41st push of the day is held by the cap",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 40, "remaining": 200, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "hold_cap"},
    {"why": "the market publisher is cap-exempt (declared, with its reason)",
     "in": {"tier": "p2", "publisher": "trade-data-market", "sent_today": 80, "remaining": 200, "et_hour": 12, "can_defer": false, "has_sink": true}, "out": "push"},
    {"why": "the exemption is by exact name, not prefix",
     "in": {"tier": "p2", "publisher": "trade-data", "sent_today": 40, "remaining": 200, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "hold_cap"},
    {"why": "76 left is above the reserve: push",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 76, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "push"},
    {"why": "75 left is inside the reserve: held",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 75, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "hold_reserve"},
    {"why": "a pager-health publisher is reserve-exempt (declared, with its reason)",
     "in": {"tier": "p2", "publisher": "am-heartbeat-watch", "sent_today": 0, "remaining": 3, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "push"},
    {"why": "... but not cap-exempt: the reserve exemption is its own list",
     "in": {"tier": "p2", "publisher": "notify-canary", "sent_today": 40, "remaining": 3, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "hold_cap"},
    {"why": "a BLIND quota probe fails open",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": null, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "push"},
    {"why": "22:00 ET opens the night window",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 200, "et_hour": 22, "can_defer": true, "has_sink": true}, "out": "defer_night"},
    {"why": "21:00 ET is still day",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 200, "et_hour": 21, "can_defer": true, "has_sink": true}, "out": "push"},
    {"why": "06:00 ET is still night",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 200, "et_hour": 6, "can_defer": true, "has_sink": true}, "out": "defer_night"},
    {"why": "07:00 ET closes the night window",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 200, "et_hour": 7, "can_defer": true, "has_sink": true}, "out": "push"},
    {"why": "a sender with no flush does not defer at night",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 200, "et_hour": 3, "can_defer": false, "has_sink": true}, "out": "push"},
    {"why": "... but still obeys the reserve",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 10, "et_hour": 3, "can_defer": false, "has_sink": true}, "out": "hold_reserve"},
    {"why": "the cap is judged before the night gate",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 40, "remaining": 200, "et_hour": 23, "can_defer": true, "has_sink": true}, "out": "hold_cap"},
    {"why": "the night gate is judged before the reserve (the flush applies the reserve itself)",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 10, "et_hour": 23, "can_defer": true, "has_sink": true}, "out": "defer_night"},
    {"why": "a cap hold with nowhere to land pushes",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 40, "remaining": 200, "et_hour": 12, "can_defer": true, "has_sink": false}, "out": "push"},
    {"why": "a reserve hold with nowhere to land pushes",
     "in": {"tier": "p2", "publisher": "x", "sent_today": 0, "remaining": 5, "et_hour": 12, "can_defer": true, "has_sink": false}, "out": "push"},
    {"why": "p1 is never capped, held or deferred",
     "in": {"tier": "p1", "publisher": "x", "sent_today": 999, "remaining": 0, "et_hour": 3, "can_defer": true, "has_sink": true}, "out": "push"},
    {"why": "p3 goes to the digest",
     "in": {"tier": "p3", "publisher": "x", "sent_today": 0, "remaining": 200, "et_hour": 12, "can_defer": true, "has_sink": true}, "out": "digest"},
    {"why": "p3 with no digest to write pushes",
     "in": {"tier": "p3", "publisher": "x", "sent_today": 0, "remaining": 200, "et_hour": 12, "can_defer": true, "has_sink": false}, "out": "push"}
  ],
  "ledger_path": [
    {"why": "UTC day, publisher as-is",
     "in": {"publisher": "trade-data", "utc": "2026-10-24T23:59:59Z"}, "out": "sent/20261024/trade-data"},
    {"why": "the day turns at 00:00 UTC, not ET",
     "in": {"publisher": "trade-data", "utc": "2026-10-25T00:00:00Z"}, "out": "sent/20261025/trade-data"},
    {"why": "unsafe characters become underscores",
     "in": {"publisher": "edge monitor/x!", "utc": "2026-10-24T12:00:00Z"}, "out": "sent/20261024/edge_monitor_x_"},
    {"why": "a long publisher is cut at 60 characters",
     "in": {"publisher": "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnop", "utc": "2026-10-24T12:00:00Z"},
     "out": "sent/20261024/abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefgh"}
  ],
  "replay_budget": [
    {"why": "plenty left: the replay's own cap binds", "in": {"remaining": 200, "cap": 20}, "out": 20},
    {"why": "only what lies above the reserve", "in": {"remaining": 80, "cap": 20}, "out": 5},
    {"why": "at the reserve: nothing", "in": {"remaining": 75, "cap": 20}, "out": 0},
    {"why": "below the reserve: nothing, never negative", "in": {"remaining": 10, "cap": 20}, "out": 0},
    {"why": "blind: the cap (fails open)", "in": {"remaining": null, "cap": 20}, "out": 20}
  ]
}
